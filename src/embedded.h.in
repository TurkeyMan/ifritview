// binary, so a bare executable (no install, no source tree) still has them.
inline constexpr char kIconSvg[] = R"ifrit_svg(@IFRIT_ICON_SVG@)ifrit_svg";
inline constexpr char kDesktopEntry[] = R"ifrit_desktop(@IFRIT_DESKTOP_ENTRY@)ifrit_desktop";
