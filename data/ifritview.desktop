[Desktop Entry]
Type=Application
Name=IfritView
GenericName=Image Viewer
Comment=Fast, no-frills image viewer
Exec=ifritview %f
Icon=ifritview
Terminal=false
StartupNotify=true
Categories=Graphics;Viewer;2DGraphics;RasterGraphics;
Keywords=image;picture;photo;viewer;raw;
MimeType=image/jpeg;image/png;image/gif;image/bmp;image/x-bmp;image/x-ms-bmp;image/webp;image/heif;image/heic;image/avif;image/jxl;image/tiff;image/svg+xml;image/x-icon;image/vnd.microsoft.icon;image/x-xpixmap;image/x-xbitmap;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;image/x-portable-anymap;image/x-tga;image/vnd.adobe.photoshop;image/x-psd;image/vnd.radiance;image/x-dcraw;image/x-adobe-dng;image/x-canon-cr2;image/x-canon-cr3;image/x-canon-crw;image/x-nikon-nef;image/x-nikon-nrw;image/x-sony-arw;image/x-sony-srf;image/x-sony-sr2;image/x-fuji-raf;image/x-olympus-orf;image/x-panasonic-rw2;image/x-panasonic-raw;image/x-pentax-pef;image/x-samsung-srw;image/x-kodak-dcr;image/x-kodak-kdc;image/x-minolta-mrw;image/x-sigma-x3f;image/x-hasselblad-3fr;image/x-phaseone-iiq;image/x-leica-rwl;image/x-epson-erf;image/x-mamiya-mef;application/pdf;
